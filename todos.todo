        <?php

namespace App\Services\Payroll;

use App\Enums\LogAction;
use App\Enums\LogModule;
use App\Models\PayrollAuditLog;
use App\Models\PayrollCatalog;
use App\Models\PayrollCompany;
use App\Models\PayrollEmployee;
use App\Models\PayrollExport;
use App\Models\PayrollHrisSyncBatch;
use App\Models\PayrollInput;
use App\Models\PayrollNotification;
use App\Models\PayrollRun;
use App\Models\PayrollRunResult;
use App\Models\PayrollRunResultIssue;
use App\Models\PayrollRunResultLine;
use App\Models\User;
use App\Services\ActivityLog\LogDescription;
use Illuminate\Contracts\Auth\Authenticatable;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Support\Facades\Auth;

class PayrollAuditLogger
{
    /**
     * @param  array<string, mixed>  $context
     */
    public function record(
        string|LogModule $module,
        string|LogAction $action,
        ?Model $auditable = null,
        array $context = [],
        ?Authenticatable $actor = null,
        ?array $oldValues = null,
        ?array $newValues = null,
    ): PayrollAuditLog {
        $actor ??= Auth::user();
        $request = app()->bound('request') ? request() : null;

        return PayrollAuditLog::query()->create([
            'user_id'            => $actor?->getAuthIdentifier(),
            'payroll_company_id' => $this->companyIdFor($auditable),
            'actor_email'        => $actor !== null && method_exists($actor, 'getAttribute') ? $actor->getAttribute('email') : null,
            'module'             => $module,
            'action'             => $action,
            'description'        => LogDescription::generate($module, $action, $actor, $auditable, $context),
            'old_values'         => $oldValues,
            'new_values'         => $newValues,
            'auditable_type'     => $auditable?->getMorphClass(),
            'auditable_id'       => $auditable?->getKey(),
            'context'            => $context,
            'ip_address'         => $request?->ip(),
            'user_agent'         => $request?->userAgent(),
        ]);
    }

    private function companyIdFor(?Model $auditable): ?int
    {
        return match (true) {
            $auditable instanceof PayrollCompany => (int) $auditable->getKey(),
            $auditable instanceof User           => (int) $auditable->company_id,
            $auditable instanceof PayrollCatalog => (int) $auditable->company_id,
            $auditable instanceof PayrollEmployee,
            $auditable instanceof PayrollInput,
            $auditable instanceof PayrollRun,
            $auditable instanceof PayrollRunResult,
            $auditable instanceof PayrollRunResultLine,
            $auditable instanceof PayrollRunResultIssue,
            $auditable instanceof PayrollHrisSyncBatch,
            $auditable instanceof PayrollNotification => (int) $auditable->payroll_company_id,
            $auditable instanceof PayrollExport       => (int) $auditable->run?->payroll_company_id ?: null,
            default                                   => null,
        };
    }
}